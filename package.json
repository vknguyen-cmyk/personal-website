{
  "name": "humanoid-wasm",
  "version": "0.1.0",
  "private": true,
  "description": "Client-side Unitree G1 simulation: MuJoCo WASM + one pretrained ONNX WBC policy + multiple motion clips.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts",
    "smoke": "node scripts/smoke.mjs http://127.0.0.1:4173/lab.html"
  },
  "dependencies": {
    "@mujoco/mujoco": "^3.10.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^5.2.0",
    "onnxruntime-web": "^1.20.1",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/three": "^0.185.0",
    "playwright": "^1.51.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  }
}
